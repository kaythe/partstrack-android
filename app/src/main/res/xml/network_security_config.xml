<!-- partstrack-web serves plain HTTP on the local network, which Android
     blocks by default since 9. Allow it; the settings screen warns that a
     token then travels unencrypted. HTTPS (e.g. behind a reverse proxy)
     works as usual, with the system's certificate authorities. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
