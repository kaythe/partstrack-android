    <string name="setup_title">Connect to partstrack</string>
    <string name="settings_title">Settings</string>
    <string name="setup_intro">Enter the address of your partstrack-web server, as you open it in a browser. The phone needs to reach it, on the local network or through a VPN.</string>
    <string name="server_address">Server address</string>
    <string name="server_address_help">For example http://parts.lan:8080/</string>
    <string name="server_address_invalid">This isn\'t a web address.</string>
    <string name="api_token">API token (optional)</string>
    <string name="api_token_help">Needed for changes. Create one on the server with \'partstrack token add phone\'. Without a token, the app only shows the inventory.</string>
    <string name="api_token_unreadable">The saved token can\'t be read any more, because the key that protects it is gone. Enter it again.</string>
    <string name="token_plain_http">The address starts with http://, so the token travels unencrypted. Use it only on a network you trust, or through a VPN.</string>
    <string name="save_failed">The token couldn\'t be stored securely on this phone, so nothing was saved. Try again, or save without a token.</string>
    <string name="check">Check</string>
    <string name="check_ready">Connected to partstrack %1$s with the token \'%2$s\'. You can make changes.</string>
    <string name="check_no_token">Connected to partstrack %1$s. Without a token, the app only shows the inventory.</string>
    <string name="check_read_only_copy">The token \'%2$s\' is valid, but this server (partstrack %1$s) shows a read-only copy, so changes can\'t be saved.</string>
    <string name="check_too_old">This server runs partstrack %1$s, which can\'t check API tokens. The app needs a newer partstrack.</string>
    <string name="check_token_invalid">The server doesn\'t accept this token. %1$s</string>
    <string name="check_unreachable">Can\'t reach the server. Check the address, and that the phone is on the right network or VPN. %1$s</string>
    <string name="check_not_partstrack">Something answered at this address, but it isn\'t a partstrack server with an API (partstrack 1.3.0 or later).</string>
